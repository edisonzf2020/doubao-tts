# 豆包 TTS OpenAI 兼容服务配置示例
#
# 用法:
#   cp .env.example .env
#   然后按需修改 .env（.env 已在 .gitignore 中，不会被提交）
#
# 说明: openai_server.py 启动时自动读取 .env；
#       已存在的系统环境变量优先级更高，不会被 .env 覆盖。


# ---------------- 鉴权（重要）----------------
# 服务持有你的豆包登录态，任何能访问端口的人都能用你的账号合成语音。
# 设置一个随机字符串作为 Bearer Token；客户端的 api_key 必须与之一致。
#   生成: python3 -c "import secrets; print('sk-' + secrets.token_urlsafe(32))"
#
# 留空 = 不鉴权，此时服务强制只绑定 127.0.0.1；
# 若留空又把 DOUBAO_TTS_HOST 设为非回环地址，服务会拒绝启动。
DOUBAO_TTS_API_KEY=sk-change-me-to-a-random-secret


# ---------------- 监听地址 ----------------
# 默认 127.0.0.1（仅本机）。
# 需要局域网/容器访问时改为 0.0.0.0，但必须同时设置 DOUBAO_TTS_API_KEY。
DOUBAO_TTS_HOST=127.0.0.1

DOUBAO_TTS_PORT=8000


# ---------------- 并发与限额 ----------------
# 同时在途的 WebSocket 连接数上限。每个请求独占一条连接，
# 超出的请求会排队而非失败。调太高容易触发豆包风控。
DOUBAO_TTS_CONCURRENCY=8

# 单次请求的文本长度上限（字符）。
DOUBAO_TTS_MAX_INPUT=4096


# ---------------- Cookie 保温 ----------------
# 核心登录态（sessionid_ss 等）有效期约 30 天，字节的心跳端点会把它
# 滚动续期到 ~29.85 天。开启后服务会定期自动续期，登录态不会过期。
# 设为 0 / false / off 可关闭。
DOUBAO_TTS_KEEPALIVE=1

# 多久检查一次（小时）。心跳端点自带节流，调低无副作用。
DOUBAO_TTS_KEEPALIVE_INTERVAL_H=12

# 剩余天数低于此值才续期。
DOUBAO_TTS_KEEPALIVE_THRESHOLD_D=25
